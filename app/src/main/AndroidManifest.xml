<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For recording a voice note on a payment. Asked for only when the user taps record. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- For asking what an untracked payment was for. Android 13+ asks the user. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps the automatic-backup check scheduled after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".BudgetApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads payment notifications of PhonePe, Paytm, Google Pay and Navi to find
             debits not recorded in the app. Only runs once the user turns on
             Notification access for the app in Settings. Nothing leaves the phone. -->
        <service
            android:name=".alerts.PaymentAlertListener"
            android:exported="false"
            android:label="Payment alerts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Every few days writes a backup zip into the folder the user picked.
             Only scheduled once they pick one on the Data screen. -->
        <service
            android:name=".backup.BackupJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- An untracked-payment notification was swiped away. -->
        <receiver
            android:name=".alerts.AlertDismissedReceiver"
            android:exported="false" />

        <!-- Lets the user open the data file in another app. Nothing is shared
             until they tap "Open file", and then only with the app they pick. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
